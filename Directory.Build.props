<Project>

  <!--
    Utsushi 全プロジェクト共通のビルド設定。
    方針の根拠は .kiro/steering/tech.md「コーディング規約」を参照。
  -->
  <PropertyGroup>
    <!-- 呼び出し元プロダクトが .NET 5 のため net5.0 固定(tech.md「実行環境」) -->
    <TargetFramework>net5.0</TargetFramework>
    <!-- 呼び出し元プロダクトの開発環境(Visual Studio 2019)が C# 9.0 までしかサポートしないため明示(tech.md「実行環境」) -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- net5.0 は EOL のため NETSDK1138 が必ず出る。既知・許容のため抑止する -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NeutralLanguage>ja-JP</NeutralLanguage>
  </PropertyGroup>

  <!--
    VS2019(16.11)同梱のC#コンパイラ(Roslyn 3.11)に差し替えてビルドする検証用スイッチ。
    新しいSDKのコンパイラは LangVersion=9.0 でも一部の挙動が新しいため、VS2019でのビルド可否はこれで確認する。
    使い方: dotnet build -p:UtsushiVs2019Compiler=true(tech.md「Visual Studio 2019 対応」)
    RoslynCompilerType を明示しないと、新しいSDKが自前のコンパイラのパスで上書きしてしまい差し替えが効かない。
  -->
  <PropertyGroup Condition="'$(UtsushiVs2019Compiler)' == 'true'">
    <RoslynCompilerType>Custom</RoslynCompilerType>
    <!-- 新しいSDK同梱のアナライザーはRoslyn 3.11に読み込めず警告CS8032が大量に出るため、この検証モードでは止める
         (アナライザー込みのビルドはCIのWindowsジョブ〔.NET 5 SDK〕が確認する) -->
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>
  <ItemGroup Condition="'$(UtsushiVs2019Compiler)' == 'true'">
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

  <!--
    テストから internal のレイアウト計算ユーティリティ等を直接検証できるようにする。
    公開APIを増やさずにユニットテストの粒度を保つため。
  -->
  <ItemGroup Condition="'$(MSBuildProjectDirectory.Contains(src))' == 'true'">
    <InternalsVisibleTo Include="$(MSBuildProjectName).Tests" />
    <InternalsVisibleTo Include="Utsushi.Golden.Tests" />
  </ItemGroup>

</Project>
